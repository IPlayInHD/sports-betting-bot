# Copy this file to .env and fill in your own credentials.
# NEVER commit your real .env file.

# --- Sportsbook odds provider (https://the-odds-api.com) ---
ODDS_API_KEY=

# --- Polymarket ---
# Public read-only market data (Gamma + CLOB) needs no key.
# Live order execution requires a funded Polygon wallet + CLOB API creds.
# Only required if ARBBOT_LIVE_TRADING=true
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=

# --- Crypto exchanges ---
# Public price feeds (Coinbase/Kraken/Binance tickers) need no key.
# Live order execution needs an API key + secret PER exchange you enable in
# config.yaml's markets.crypto.exchanges list. Only required if mode: live.
CRYPTO_COINBASE_API_KEY=
CRYPTO_COINBASE_API_SECRET=
CRYPTO_KRAKEN_API_KEY=
CRYPTO_KRAKEN_API_SECRET=
CRYPTO_BINANCEUS_API_KEY=
CRYPTO_BINANCEUS_API_SECRET=

# --- Safety switch ---
# Must be explicitly set to "true" (and ARBBOT_LIVE_TRADING=true in config)
# for the bot to place real orders. Defaults to paper trading otherwise.
I_UNDERSTAND_THE_RISKS=false

# --- Optional alerting ---
ALERT_WEBHOOK_URL=
